<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookbyte : Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="flex w-full h-screen justify-center items-center">

      
        <div class="w-full ">
            <div class="text-center mb-7 ">
                <h1 class="text-5xl font-medium text-red-700">Register</h1>
            </div>
        <form action="/create" autocomplete="off" method="post" class="w-full space-y-5 flex flex-col justify-center items-center">
            <div class="w-2/3 space-y-3">
                <label for="name" class="text-[18px] text-gray-500 ">Name</label> <br>
                <input type="name" name="name" id="name" placeholder="Enter Your Name" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
            <div class="w-2/3 space-y-3">
                <label for="username" class="text-[18px] text-gray-500 ">Username</label> <br>
                <input type="username" name="username" id="username" placeholder="Enter Your Username" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
            <div class="w-2/3 space-y-3">
                <label for="email" class="text-[18px] text-gray-500 ">Email</label> <br>
                <input type="email" name="email" id="email" placeholder="Enter Your Email" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
            <div class="w-2/3 space-y-3">
                <label for="email" class="text-[18px] text-gray-500 ">Password</label> <br>
                <input type="password" name="password" id="password" placeholder="Enter Your Password" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
        
        
            <input type="submit" value="Register" class="cursor-pointer py-3 px-10 bg-red-700 text-white font-bold text-xl rounded-md">
        </form>
        </div>
    </div>
</body>
</html>