<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    

</head>
<body>
    <div class="flex w-full h-screen">




        <div class="flex flex-col justify-center items-center w-[60%]">
            <div class="flex flex-col items-center justify-center mb-7 space-y-3">
                <h1 class="text-5xl flex items-center text-red-700 px-2">
                    Welcome to Algo_Explainer
                </h1>
                
                <h1 class="text-5xl font-medium text-red-700">Login</h1>
            </div>
        <form action="/login" autocomplete="off" method="post" class="w-full space-y-5 flex flex-col justify-center items-center">
            <div class="w-[60%] space-y-3">
                <label for="email" class="text-[18px] text-gray-500 ">Email</label> <br>
                <input type="email" name="email" id="email" placeholder="Enter Your Email" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
            <div class="w-[60%] space-y-3">
                <label for="email" class="text-[18px] text-gray-500 ">Password</label> <br>
                <input type="password" name="password" id="password" placeholder="Enter Your Password" class="border-b-2 outline-none  w-full text-xl text-gray-400 pl-3 pb-1">
            </div>
        
            <h3><span class="text-gray-500">Doesn't have a account yet?</span> <a href="/register" class="font-medium">Register Now</a></h3>
        
            <input type="submit" value="Login" class="cursor-pointer py-3 px-10 bg-red-700 text-white font-bold text-xl rounded-md">
        </form>
        </div>

        <div class="w-[50%] h-full">
            <img src="/images/login4.jpg" alt="" class="w-full h-full">
        </div>
    </div>
</body>
</html>